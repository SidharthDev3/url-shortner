# Local SQLite (default)
PORT=8080
BASE_URL=http://localhost:8080
DB_DRIVER=sqlite
DB_PATH=./data/urls.db

# Amazon RDS for MySQL
# Do not commit real credentials. Set DB_DSN in your deployment environment instead.
# DB_DRIVER=mysql
# DB_TLS_CA_FILE=C:\path\to\global-bundle.pem
# DB_DSN=app_user:replace-with-url-escaped-password@tcp(your-rds-endpoint.amazonaws.com:3306)/url_shortener?parseTime=true&loc=UTC&tls=rds&timeout=10s&readTimeout=10s&writeTimeout=10s
